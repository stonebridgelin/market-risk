# FRED API 密钥：https://fred.stlouisfed.org/docs/api/api_key.html 免费申请
FRED_API_KEY=your_fred_api_key_here

# Tiingo API 密钥（可选，只用于核对 ETF 不复权收盘价，tv crosscheck 第三方核对）：https://www.tiingo.com 免费注册
TIINGO_API_KEY=your_tiingo_api_key_here

# MySQL 兼容性验证库（可选，market-risk db verify-mysql 使用；专用于验证、可清空的空库）
# 例：mysql+pymysql://用户:密码@主机:3306/库名?charset=utf8mb4
MYSQL_VERIFY_URL=
